      "id": "9f5bf4d4-4920-4db0-a31c-245f905dae47",
      "name": "Stock Input"
    },
    {
      "parameters": {
        "url": "={{ 'https://query1.finance.yahoo.com/v8/finance/chart/' + $('Stock Input').first().json.ticker + '?range=3mo&interval=1d' }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -112,
        160
      ],
      "id": "edacd832-c87b-4054-a9e4-54e300bbd628",
      "name": "Fetch Market Data",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json.chart?.result?.[0];\n\nif (!result) {\n  const message = $input.first().json.chart?.error?.description;\n  throw new Error(message || 'No market data returned by the API.');\n}\n\nconst quote = result.indicators?.quote?.[0];\nconst timestamps = result.timestamp || [];\nconst closes = quote?.close || [];\nconst volumes = quote?.volume || [];\n\nconst candles = timestamps\n  .map((timestamp, i) => ({\n    date: new Date(timestamp * 1000).toISOString().slice(0, 10),\n    close: closes[i],\n    volume: volumes[i] ?? null,\n  }))\n  .filter(candle => Number.isFinite(candle.close));\n\nif (candles.length < 30) {\n  throw new Error(`Insufficient valid closing prices: ${candles.length}`);\n}\n\nreturn [{\n  json: {\n    ticker: result.meta?.symbol || $('Stock Input').first().json.ticker,\n    currency: result.meta?.currency || null,\n    exchangeTimezone: result.meta?.exchangeTimezoneName || null,\n    latestClose: candles[candles.length - 1].close,\n    latestDate: candles[candles.length - 1].date,\n    candles,\n    dataPoints: candles.length,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        64
      ],
      "id": "eb53280a-a58d-40cc-9898-797afa9d2461",
      "name": "Extract Market Data"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst candles = data.candles || [];\nconst closes = candles.map(c => c.close);\n\nfunction sma(values, period) {\n  if (values.length < period) return null;\n  const slice = values.slice(-period);\n  return slice.reduce((sum, value) => sum + value, 0) / period;\n}\n\nfunction rsi(values, period = 14) {\n  if (values.length < period + 1) return null;\n  let gains = 0;\n  let losses = 0;\n\n  for (let i = values.length - period; i < values.length; i++) {\n    const change = values[i] - values[i - 1];\n    if (change > 0) gains += change;\n    else losses -= change;\n  }\n\n  const avgGain = gains / period;\n  const avgLoss = losses / period;\n\n  if (avgLoss === 0) return avgGain === 0 ? 50 : 100;\n  return 100 - (100 / (1 + avgGain / avgLoss));\n}\n\nconst sma20 = sma(closes, 20);\nconst sma50 = sma(closes, 50);\nconst rsi14 = rsi(closes, 14);\n\nif (sma20 === null || sma50 === null || rsi14 === null) {\n  throw new Error('Insufficient closing-price history for indicators.');\n}\n\nreturn [{\n  json: {\n    ...data,\n    indicators: {\n      sma20: Number(sma20.toFixed(4)),\n      sma50: Number(sma50.toFixed(4)),\n      rsi14: Number(rsi14.toFixed(2)),\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        64
      ],
      "id": "2913a1b8-141a-4995-bdf5-15e2cd321f9d",
      "name": "Calculate Indicators"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst closes = (data.candles || []).map(c => c.close);\n\nfunction emaSeries(values, period) {\n  if (values.length < period) return [];\n\n  const k = 2 / (period + 1);\n  let ema = values.slice(0, period)\n    .reduce((a, b) => a + b, 0) / period;\n\n  const output = Array(period - 1).fill(null);\n  output.push(ema);\n\n  for (let i = period; i < values.length; i++) {\n    ema = values[i] * k + ema * (1 - k);\n    output.push(ema);\n  }\n\n  return output;\n}\n\nconst ema12 = emaSeries(closes, 12);\nconst ema26 = emaSeries(closes, 26);\n\nconst macdSeries = closes.map((_, i) =>\n  ema12[i] !== null && ema26[i] !== null\n    ? ema12[i] - ema26[i]\n    : null\n);\n\nconst validMacd = macdSeries.filter(v => v !== null);\nconst signalValues = emaSeries(validMacd, 9);\n\nif (validMacd.length < 9 || signalValues.length === 0) {\n  throw new Error('Insufficient price history to calculate MACD.');\n}\n\nconst macd = validMacd[validMacd.length - 1];\nconst signal = signalValues[signalValues.length - 1];\n\nreturn [{\n  json: {\n    ...data,\n    indicators: {\n      ...data.indicators,\n      macd: Number(macd.toFixed(4)),\n      macdSignal: Number(signal.toFixed(4)),\n      macdHistogram: Number((macd - signal).toFixed(4)),\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        64
      ],
      "id": "476b50dc-b68f-46d5-bb9a-a9304d4b5e85",
      "name": "Calculate MACD"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst i = data.indicators;\n\nif (!i || [i.sma20, i.sma50, i.rsi14, i.macd, i.macdSignal]\n  .some(v => !Number.isFinite(v))) {\n  throw new Error('Missing or invalid technical indicators.');\n}\n\nlet score = 0;\nconst reasons = [];\n\nif (i.sma20 > i.sma50) {\n  score++;\n  reasons.push('SMA 20 is above SMA 50 (bullish trend signal).');\n} else {\n  score--;\n  reasons.push('SMA 20 is below or equal to SMA 50 (bearish trend signal).');\n}\n\nif (i.rsi14 < 30) {\n  score++;\n  reasons.push('RSI is below 30 (potentially oversold).');\n} else if (i.rsi14 > 70) {\n  score--;\n  reasons.push('RSI is above 70 (potentially overbought).');\n} else {\n  reasons.push('RSI is between 30 and 70.');\n}\n\nif (i.macd > i.macdSignal) {\n  score++;\n  reasons.push('MACD is above its signal line (positive momentum signal).');\n} else {\n  score--;\n  reasons.push('MACD is below or equal to its signal line (negative momentum signal).');\n}\n\nconst signal = score >= 2 ? 'BUY' : score <= -2 ? 'SELL' : 'HOLD';\n\nreturn [{\n  json: {\n    ...data,\n    technicalSignal: signal,\n    signalScore: score,\n    signalReasons: reasons,\n    signalDisclaimer: 'Rule-based educational signal; not personalized financial advice.'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
